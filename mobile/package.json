{
  "name": "sinorus-tradelite-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "node tools/start.mjs",
    "start:tunnel": "node tools/start.mjs --tunnel",
    "start:usb": "node tools/start.mjs --localhost",
    "qr": "node tools/start.mjs --qr-only",
    "android": "node tools/start.mjs --android",
    "ios": "node tools/start.mjs --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node tools/check-i18n.mjs",
    "preview": "expo export --platform web --output-dir web-preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3"
  }
}
